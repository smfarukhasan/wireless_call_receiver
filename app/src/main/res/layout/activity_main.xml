<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark">

    <!-- ─── COLORFUL AMBIENT GLOWING CIRCLES (BACKGROUND LAYER) ─────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:importantForAccessibility="no">

        <View
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-80dp"
            android:background="@drawable/ambient_circle_blue"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="-90dp"
            android:layout_marginTop="60dp"
            android:background="@drawable/ambient_circle_purple"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-70dp"
            android:layout_marginTop="200dp"
            android:background="@drawable/ambient_circle_pink"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-40dp"
            android:layout_marginBottom="-70dp"
            android:background="@drawable/ambient_circle_cyan"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <!-- ─── FOREGROUND CONTENT LAYER ────────────────────────────────────── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Title & Subtitle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/tvMainTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/accent_blue_bright"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:accessibilityHeading="true" />

                    <TextView
                        android:id="@+id/tvMainSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- ─── UNIFIED CONTROLS GROUP CARD ──────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMainControlsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/glass_card_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_card_stroke"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Inner Master Service Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardMasterInner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/glass_card_master_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/glass_card_active_stroke"
                            app:strokeWidth="1.2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp">

                                <TextView
                                    android:id="@+id/tvMasterSwitchTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/main_master_switch_title"
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:importantForAccessibility="no" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/switchMasterToggle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="60dp"
                                    android:minHeight="44dp"
                                    android:contentDescription="@string/acc_master_switch_desc" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Sub-Switches Container -->
                        <LinearLayout
                            android:id="@+id/layoutSubSwitchesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp">

                            <!-- 1. Lock Screen Call Receive Item -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tvReceiveLockedTitle"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/main_locked_screen_receive_title"
                                        android:textColor="@color/white"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:importantForAccessibility="no" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchReceiveLocked"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="60dp"
                                        android:minHeight="44dp"
                                        android:contentDescription="@string/acc_locked_switch_desc" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvReceiveLockedDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/main_locked_screen_receive_desc_on"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13.5sp"
                                    android:importantForAccessibility="no" />

                            </LinearLayout>

                            <!-- Divider 1 -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="18dp"
                                android:layout_marginEnd="18dp"
                                android:background="@color/divider_color"
                                android:importantForAccessibility="no" />

                            <!-- 2. Unlocked Screen Call Receive Item -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tvReceiveUnlockedTitle"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/main_unlocked_screen_receive_title"
                                        android:textColor="@color/white"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:importantForAccessibility="no" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchReceiveUnlocked"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="60dp"
                                        android:minHeight="44dp"
                                        android:contentDescription="@string/acc_unlocked_switch_desc" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvReceiveUnlockedDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/main_unlocked_screen_receive_desc_off"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13.5sp"
                                    android:importantForAccessibility="no" />

                            </LinearLayout>

                            <!-- Divider 2 -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="18dp"
                                android:layout_marginEnd="18dp"
                                android:background="@color/divider_color"
                                android:importantForAccessibility="no" />

                            <!-- 3. Auto-Answer Switch Item -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tvAutoAnswerTitle"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/main_auto_answer_title"
                                        android:textColor="@color/white"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:importantForAccessibility="no" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchAutoAnswer"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="60dp"
                                        android:minHeight="44dp"
                                        android:contentDescription="@string/acc_auto_answer_switch_desc" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvAutoAnswerDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/main_auto_answer_off"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13.5sp"
                                    android:importantForAccessibility="no" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── STATUS DASHBOARD SECTION ───────────────────────────── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/dashboard_status_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <!-- Unified Status Dashboard Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardBackgroundColor="@color/glass_card_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_card_stroke"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Item 1: Bluetooth Connection Status -->
                        <LinearLayout
                            android:id="@+id/layoutBtStatusItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingTop="15dp"
                            android:paddingBottom="15dp"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvBtStatusCardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/main_bt_status_title"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tvBtStatusCardValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/main_bt_disconnected"
                                android:textColor="@color/status_red"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:importantForAccessibility="no" />

                        </LinearLayout>

                        <!-- Divider 1 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"
                            android:background="@color/divider_color"
                            android:importantForAccessibility="no" />

                        <!-- Item 2: Accessibility Service Status -->
                        <LinearLayout
                            android:id="@+id/layoutAccStatusItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingTop="15dp"
                            android:paddingBottom="15dp"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvAccStatusCardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/main_acc_status_title"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tvAccStatusCardValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/status_disabled"
                                android:textColor="@color/status_red"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:importantForAccessibility="no" />

                        </LinearLayout>

                        <!-- Divider 2 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"
                            android:background="@color/divider_color"
                            android:importantForAccessibility="no" />

                        <!-- Item 3: Battery Optimization Status -->
                        <LinearLayout
                            android:id="@+id/layoutBattStatusItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingTop="15dp"
                            android:paddingBottom="15dp"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvBattStatusCardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/main_batt_status_title"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tvBattStatusCardValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/status_disabled"
                                android:textColor="@color/status_red"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:importantForAccessibility="no" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── ACTION BUTTONS FOOTER ───────────────────────────── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMainChangeLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/accent_blue"
                    android:text="@string/btn_change_language"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    android:contentDescription="@string/acc_btn_change_language_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMainRerunSetup"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/btn_rerun_setup"
                    android:textColor="@color/accent_blue_bright"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/accent_blue"
                    app:strokeWidth="1.5dp"
                    android:contentDescription="@string/acc_btn_rerun_setup_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMainPrivacyTerms"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/btn_privacy_terms"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:contentDescription="@string/acc_btn_privacy_desc" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
