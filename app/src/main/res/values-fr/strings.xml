<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">BT Reception Appel</string>

    <!-- Language Selection Screen -->
    <string name="title_select_language">Sélectionner la Langue</string>
    <string name="subtitle_select_language">Choisissez votre langue préférée pour le lecteur d\'écran et l\'interface.</string>
    <string name="btn_continue">Continuer</string>

    <!-- Onboarding / Setup Screen -->
    <string name="title_onboarding">Configuration &amp; Autorisations</string>
    <string name="subtitle_onboarding">Veuillez compléter les 3 étapes suivantes pour recevoir les appels avec le bouton Bluetooth.</string>
    
    <string name="perm_bt_title">1. Autorisation Bluetooth</string>
    <string name="perm_bt_desc">Nécessaire pour détecter la connexion de vos écouteurs Bluetooth.</string>
    <string name="perm_bt_grant_btn">Accorder l\'autorisation Bluetooth</string>

    <string name="perm_acc_title">2. Service d\'Accessibilité</string>
    <string name="perm_acc_desc">Permet de détecter les appels entrants (WhatsApp, Messenger, Téléphone) et de décrocher avec le bouton du casque.</string>
    <string name="perm_acc_grant_btn">Ouvrir les paramètres d\'accessibilité</string>

    <string name="perm_batt_title">3. Désactiver l\'Optimisation de la Batterie</string>
    <string name="perm_batt_desc">Empêche Android d\'arrêter le service en arrière-plan lorsque votre appareil Bluetooth est actif.</string>
    <string name="perm_batt_grant_btn">Désactiver l\'optimisation batterie</string>

    <string name="btn_finish_setup">Terminer la configuration</string>
    <string name="status_granted">Accordé</string>
    <string name="status_not_granted">Non accordé - Action requise</string>
    <string name="status_enabled">Activé</string>
    <string name="status_disabled">Désactivé - Action requise</string>

    <!-- Main Screen -->
    <string name="main_master_switch_title">Interrupteur Principal</string>
    <string name="main_master_switch_on">Interrupteur ACTIVÉ : L\'application surveille les appels entrants via le bouton Bluetooth.</string>
    <string name="main_master_switch_off">Interrupteur DÉSACTIVÉ : Les activités en arrière-plan sont arrêtées pour économiser la batterie.</string>
    <string name="main_auto_answer_title">Réponse Automatique</string>
    <string name="main_auto_answer_on">Réponse auto ACTIVÉE : Les appels seront décrochés automatiquement lors de la détection.</string>
    <string name="main_auto_answer_off">Réponse auto DÉSACTIVÉE : Les appels seront décrochés UNIQUEMENT en appuyant sur le bouton Bluetooth.</string>
    <string name="main_bt_status_title">Connexion Bluetooth</string>
