    <string name="accessibility_service_label">Service BT Réception Appel</string>
    <string name="accessibility_service_description">Surveille les appels entrants pour le téléphone, WhatsApp, Messenger et Telegram. Décroche les appels lors de l\'appui sur le bouton du casque. 100% hors ligne.</string>
    <string name="notification_channel_name">Statut Réception BT</string>
    <string name="notification_title">Récepteur d\'Appels BT Actif</string>
    <string name="notification_desc">Prêt à répondre aux appels entrants avec le bouton Bluetooth.</string>
    <string name="call_answered_announcement">Appel répondu via le bouton Bluetooth.</string>
