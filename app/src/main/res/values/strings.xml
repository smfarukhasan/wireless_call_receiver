    <string name="accessibility_service_label">BT Receive Call Service</string>
    <string name="accessibility_service_description">Monitors incoming call screens for standard dialers, WhatsApp, Messenger, and Telegram. Simulates answer action when Bluetooth headset media button is pressed. Safe and 100% offline.</string>
    <string name="notification_channel_name">BT Receive Call Status</string>
    <string name="notification_title">BT Call Receiver Active</string>
    <string name="notification_desc">Ready to answer incoming calls with connected Bluetooth button.</string>
