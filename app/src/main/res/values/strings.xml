<resources>
    <string name="app_name">BT Receive Call</string>

    <!-- Language Selection Screen -->
    <string name="title_select_language">Select Language</string>
    <string name="subtitle_select_language">Choose your preferred language for screen reader announcements and interface text.</string>
    <string name="btn_continue">Continue</string>

    <!-- Onboarding / Setup Screen -->
    <string name="title_onboarding">App Setup &amp; Permissions</string>
    <string name="subtitle_onboarding">Please complete the following 3 steps so the app can receive incoming calls with your Bluetooth button.</string>
    
    <string name="perm_bt_title">1. Bluetooth Permission</string>
    <string name="perm_bt_desc">Needed to detect when your Bluetooth headphones or neckband are connected.</string>
    <string name="perm_bt_grant_btn">Grant Bluetooth Permission</string>

    <string name="perm_acc_title">2. Accessibility Service</string>
    <string name="perm_acc_desc">Allows the app to detect incoming calls on WhatsApp, Messenger, or Phone and trigger the answer button when you click your headset key.</string>
    <string name="perm_acc_grant_btn">Open Accessibility Settings</string>

    <string name="perm_batt_title">3. Disable Battery Optimization</string>
    <string name="perm_batt_desc">Prevents Android from killing the call monitoring service when your Bluetooth device is active.</string>
    <string name="perm_batt_grant_btn">Disable Battery Optimization</string>

    <string name="btn_finish_setup">Finish Setup and Go to Main App</string>
    <string name="status_granted">Granted</string>
    <string name="status_not_granted">Not Granted - Action Required</string>
    <string name="status_enabled">Enabled</string>
    <string name="status_disabled">Disabled - Action Required</string>

    <!-- Main Screen -->
    <string name="main_master_switch_title">Master Service Switch</string>
    <string name="main_master_switch_on">Master Switch ON: App is monitoring for incoming calls via Bluetooth device.</string>
    <string name="main_master_switch_off">Master Switch OFF: App background activities are completely stopped to save battery.</string>
    <string name="main_auto_answer_title">Auto-Answer Calls</string>
    <string name="main_auto_answer_on">Auto-Answer ON: Calls will be answered automatically when detected.</string>
    <string name="main_auto_answer_off">Auto-Answer OFF: Calls will ONLY be answered when Bluetooth button is pressed.</string>
